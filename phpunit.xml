<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/11.5/phpunit.xsd" colors="true" cacheDirectory=".phpunit.cache">
  <testsuite name="PHP 8 Appreciate Test Suite">
    <directory>./test</directory>
    <exclude>./test/solutions</exclude>
  </testsuite>
  <source>
    <include>
      <directory suffix=".php">./src</directory>
    </include>
  </source>
  <php>
    <env name="SANDBOX" value="docker" />
  </php>
</phpunit>
